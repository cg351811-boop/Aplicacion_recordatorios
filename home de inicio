<ion-header class="ion-no-border">
  <ion-toolbar class="header-toolbar">
    <div class="header-container">
      <div class="user-greeting">
        <h1>Hola,</h1>
        <p>Aquí están tus tareas y recordatorios</p>
      </div>
      <!-- Botón (+) superior derecho para agregar nueva tarea/recordatorio -->
      <ion-button [routerLink]="['/crear-tarea']" fill="clear" class="add-top-btn">
        <ion-icon slot="icon-only" name="add"></ion-icon>
      </ion-button>
    </div>
  </ion-toolbar>
</ion-header>

<ion-content class="ion-padding custom-background">

  <!-- Lista de Elementos -->
  <ion-list class="transparent-list">

    <!-- Tarjeta 1: Terminar reporte -->
    <ion-card class="item-card">
      <ion-card-content>
        <div class="card-header-row">
          <div class="icon-box purple-box">
            <ion-icon name="document-text-outline"></ion-icon>
          </div>
          <div class="card-details">
            <div class="title-badge-row">
              <h2>Terminar reporte</h2>
              <ion-badge class="badge-task">Tarea</ion-badge>
            </div>
            <p class="date-info">
              <ion-icon name="calendar-outline"></ion-icon>
              Creado: 10 abr 2025
            </p>
            <p class="date-info">
              <ion-icon name="time-outline"></ion-icon>
              Límite: 15 abr 2025
            </p>
          </div>
          <ion-button fill="clear" class="more-btn">
            <ion-icon slot="icon-only" name="ellipsis-vertical"></ion-icon>
          </ion-button>
        </div>
      </ion-card-content>
    </ion-card>

    <!-- Tarjeta 2: Llamar a mi mamá -->
    <ion-card class="item-card">
      <ion-card-content>
        <div class="card-header-row">
          <div class="icon-box purple-box">
            <ion-icon name="notifications-outline"></ion-icon>
          </div>
          <div class="card-details">
            <div class="title-badge-row">
              <h2>Llamar a mi mamá</h2>
              <ion-badge class="badge-reminder">Recordatorio</ion-badge>
            </div>
            <p class="date-info">
              <ion-icon name="calendar-outline"></ion-icon>
              Creado: 8 abr 2025
            </p>
            <p class="date-info">
              <ion-icon name="notifications-outline"></ion-icon>
              Activo (varios días)
            </p>
          </div>
          <ion-button fill="clear" class="more-btn">
            <ion-icon slot="icon-only" name="ellipsis-vertical"></ion-icon>
          </ion-button>
        </div>
      </ion-card-content>
    </ion-card>

    <!-- Tarjeta 3: Estudiar para el examen -->
    <ion-card class="item-card">
      <ion-card-content>
        <div class="card-header-row">
          <div class="icon-box purple-box">
            <ion-icon name="document-text-outline"></ion-icon>
          </div>
          <div class="card-details">
            <div class="title-badge-row">
              <h2>Estudiar para el examen</h2>
              <ion-badge class="badge-task">Tarea</ion-badge>
            </div>
            <p class="date-info">
              <ion-icon name="calendar-outline"></ion-icon>
              Creado: 5 abr 2025
            </p>
            <p class="date-info">
              <ion-icon name="time-outline"></ion-icon>
              Límite: 12 abr 2025
            </p>
          </div>
          <ion-button fill="clear" class="more-btn">
            <ion-icon slot="icon-only" name="ellipsis-vertical"></ion-icon>
          </ion-button>
        </div>
      </ion-card-content>
    </ion-card>

    <!-- Tarjeta 4: Tomar medicina -->
    <ion-card class="item-card">
      <ion-card-content>
        <div class="card-header-row">
          <div class="icon-box purple-box">
            <ion-icon name="notifications-outline"></ion-icon>
          </div>
          <div class="card-details">
            <div class="title-badge-row">
              <h2>Tomar medicina</h2>
              <ion-badge class="badge-reminder">Recordatorio</ion-badge>
            </div>
            <p class="date-info">
              <ion-icon name="calendar-outline"></ion-icon>
              Creado: 3 abr 2025
            </p>
            <p class="date-info">
              <ion-icon name="notifications-outline"></ion-icon>
              Activo (varios días)
            </p>
          </div>
          <ion-button fill="clear" class="more-btn">
            <ion-icon slot="icon-only" name="ellipsis-vertical"></ion-icon>
          </ion-button>
        </div>
      </ion-card-content>
    </ion-card>

    <!-- Tarjeta 5: Comprar despensa -->
    <ion-card class="item-card">
      <ion-card-content>
        <div class="card-header-row">
          <div class="icon-box purple-box">
            <ion-icon name="document-text-outline"></ion-icon>
          </div>
          <div class="card-details">
            <div class="title-badge-row">
              <h2>Comprar despensa</h2>
              <ion-badge class="badge-task">Tarea</ion-badge>
            </div>
            <p class="date-info">
              <ion-icon name="calendar-outline"></ion-icon>
              Creado: 1 abr 2025
            </p>
            <p class="date-info">
              <ion-icon name="time-outline"></ion-icon>
              Límite: 7 abr 2025
            </p>
          </div>
          <ion-button fill="clear" class="more-btn">
            <ion-icon slot="icon-only" name="ellipsis-vertical"></ion-icon>
          </ion-button>
        </div>
      </ion-card-content>
    </ion-card>

  </ion-list>

</ion-content>

<!-- BARRA DE NAVEGACIÓN INFERIOR (TABS O BOTONES DE REDIRECCIÓN) -->
<ion-footer class="ion-no-border">
  <ion-toolbar class="footer-toolbar">
    <div class="bottom-nav">

      <!-- Botón 1: Inicio -->
      <!-- Cambia '/inicio' por el nombre de tu ruta o carpeta -->
      <ion-button class="nav-btn active" fill="clear" [routerLink]="['/inicio']">
        <div class="nav-item">
          <ion-icon name="home"></ion-icon>
          <span>Inicio</span>
        </div>
      </ion-button>

      <!-- Botón 2: Crear -->
      <!-- Cambia '/crear' por el nombre de tu ruta o carpeta -->
      <ion-button class="nav-btn" fill="clear" [routerLink]="['/crear']">
        <div class="nav-item">
          <ion-icon name="add-circle-outline"></ion-icon>
          <span>Crear</span>
        </div>
      </ion-button>

      <!-- Botón 3: Configuración -->
      <!-- Cambia '/configuracion' por el nombre de tu ruta o carpeta -->
      <ion-button class="nav-btn" fill="clear" [routerLink]="['/configuracion']">
        <div class="nav-item">
          <ion-icon name="settings-outline"></ion-icon>
          <span>Configuración</span>
        </div>
      </ion-button>

      <!-- Botón 4: Calendario -->
      <!-- Cambia '/calendario' por el nombre de tu ruta o carpeta -->
      <ion-button class="nav-btn" fill="clear" [routerLink]="['/calendario']">
        <div class="nav-item">
          <ion-icon name="calendar-outline"></ion-icon>
          <span>Calendario</span>
        </div>
      </ion-button>

    </div>
  </ion-toolbar>
</ion-footer>
