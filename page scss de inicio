:host {
  --purple-main: #6C5CE7;
  --purple-light: #EFEAFF;
  --green-light: #D4F4E2;
  --green-text: #27AE60;
  --bg-color: #F8F9FD;
  --text-dark: #2D3436;
  --text-muted: #A0A5B5;
}

/* Header estilos */
.header-toolbar {
  --background: var(--bg-color);
  padding: 16px 16px 0 16px;
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-greeting h1 {
  color: var(--purple-main);
  font-weight: 700;
  font-size: 28px;
  margin: 0;
}

.user-greeting p {
  color: #8E8EA1;
  font-size: 14px;
  margin: 4px 0 0 0;
}

.add-top-btn {
  --background: var(--purple-main);
  --color: white;
  --border-radius: 50%;
  width: 44px;
  height: 44px;
  margin: 0;
}

/* Fondo de pantalla */
.custom-background {
  --background: var(--bg-color);
}

.transparent-list {
  background: transparent;
  padding: 0;
}

/* Tarjetas */
.item-card {
  border-radius: 16px;
  box-shadow: 0px 4px 12px rgba(108, 92, 231, 0.05);
  margin: 0 0 12px 0;
  background: #FFFFFF;
}

.card-header-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.icon-box {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.purple-box {
  background: var(--purple-light);
  color: var(--purple-main);
}

.card-details {
  flex-grow: 1;
}

.title-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.title-badge-row h2 {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-dark);
  margin: 0;
}

/* Badges (Etiquetas de Tarea / Recordatorio) */
.badge-task {
  --background: var(--purple-light);
  --color: var(--purple-main);
  border-radius: 12px;
  padding: 6px 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: none;
}

.badge-reminder {
  --background: var(--green-light);
  --color: var(--green-text);
  border-radius: 12px;
  padding: 6px 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: none;
}

.date-info {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--text-muted);
  margin: 3px 0;
}

.more-btn {
  --color: #A0A5B5;
  margin: -8px -8px 0 0;
}

/* Navbar Inferior */
.footer-toolbar {
  --background: #FFFFFF;
  border-top: 1px solid #F0F0F5;
  padding: 6px 0;
}

.bottom-nav {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.nav-btn {
  --color: #A0A5B5;
  margin: 0;
  text-transform: none;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.nav-item ion-icon {
  font-size: 22px;
}

.nav-item span {
  font-size: 11px;
  font-weight: 500;
}

/* Estilo para el botón activo */
.nav-btn.active {
  --color: var(--purple-main);
}

.nav-btn.active .nav-item {
  background: var(--purple-light);
  padding: 6px 16px;
  border-radius: 16px;
}
